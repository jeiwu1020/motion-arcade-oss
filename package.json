{
  "name": "motion-arcade",
  "private": true,
  "version": "0.0.0",
  "description": "Browser-based motion gaming platform for accessible and adaptive play.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeiwu1020/motion-arcade.git"
  },
  "bugs": {
    "url": "https://github.com/jeiwu1020/motion-arcade/issues"
  },
  "homepage": "https://github.com/jeiwu1020/motion-arcade#readme",
  "type": "module",
  "scripts": {
    "prepare:mediapipe": "node scripts/copy-mediapipe-wasm.mjs",
    "predev": "npm run prepare:mediapipe",
    "dev": "vite",
    "prebuild": "npm run prepare:mediapipe",
    "build": "tsc -b && vite build && node scripts/verify-mediapipe-build-assets.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "prepreview": "npm run prepare:mediapipe",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "phaser": "4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}
